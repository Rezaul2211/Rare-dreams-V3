# GROK_API_KEY / XAI_API_KEY: Required for Grok AI chatbot and automation.
# Obtain your key from https://console.x.ai/ (starts with xai-...) or Groq https://console.groq.com (starts with gsk_...)
GROK_API_KEY=
XAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Steadfast Courier Service Integration (https://portal.steadfast.com.bd)
# Obtain from Steadfast Merchant Dashboard -> Settings / API
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

